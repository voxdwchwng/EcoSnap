<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền mạng để kết nối Supabase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Quyền phần cứng Camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!-- Quyền định vị GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Quyền đọc tệp phương tiện & vị trí EXIF nguyên bản -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> <!-- Android 13+ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcoSnap">

        <!-- Màn hình Đăng nhập / Đăng ký: AuthActivity -->
        <activity
            android:name=".presentation.auth.AuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Màn hình khởi chạy chính (Trực tiếp trong phiên bản kiểm thử): HomeMapActivity -->
        <activity
            android:name=".presentation.map.HomeMapActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình CameraX & Giám sát: CameraActivity -->
        <activity
            android:name=".presentation.camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Màn hình Danh sách phường: WardListActivity -->
        <activity
            android:name=".presentation.ward.WardListActivity"
            android:exported="false" />

        <!-- Màn hình Danh sách ảnh rác theo phường: PhotoListActivity -->
        <activity
            android:name=".presentation.photo.PhotoListActivity"
            android:exported="false" />

    </application>

</manifest>
