<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.map.HomeMapActivity">

    <!-- MapLibre MapView Full Screen -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Header Summary Card & Pollution Filter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeaderMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#CC1C1B1F"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMapTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bản đồ Giám sát Ô nhiễm"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMapSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Đang phân tích cụm ô nhiễm..."
                        android:textColor="#D0D0D0"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshMap"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Làm mới"
                    app:icon="@drawable/ic_list"
                    app:iconTint="@android:color/white" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgPollutionFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/filter_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterLow"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_bin_normal"
                    android:textColor="#4CAF50"
                    app:chipStrokeColor="#4CAF50" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterMedium"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_bin_full"
                    android:textColor="#FF9800"
                    app:chipStrokeColor="#FF9800" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterHigh"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_trash_spill"
                    android:textColor="#E53935"
                    app:chipStrokeColor="#E53935" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Left Vertical Zoom Controls (Zoom In / Zoom Out) -->
    <LinearLayout
        android:id="@+id/layoutZoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:contentDescription="Phóng to bản đồ"
            app:backgroundTint="@android:color/white"
            app:elevation="4dp"
            app:fabCustomSize="42dp"
            app:srcCompat="@drawable/ic_add"
            app:tint="?attr/colorPrimary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Thu nhỏ bản đồ"
            app:backgroundTint="@android:color/white"
            app:elevation="4dp"
            app:fabCustomSize="42dp"
            app:srcCompat="@drawable/ic_remove"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

    <!-- Bottom Right Action Controls (Vertical Layout) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Button 0: Chuyển đổi chế độ xem Bản đồ nhiệt (Heatmap) / Marker -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnToggleMapMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Chuyển chế độ xem Bản đồ nhiệt"
            app:backgroundTint="@android:color/white"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:srcCompat="@drawable/ic_heatmap"
            app:tint="?attr/colorPrimary" />

        <!-- Button 1: Xem danh sách ảnh / khu vực (Size 48dp, Background White, Icon List) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnViewList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="Xem danh sách khu vực"
            app:backgroundTint="@android:color/white"
            app:elevation="6dp"
            app:fabCustomSize="48dp"
            app:srcCompat="@drawable/ic_list"
            app:tint="?attr/colorPrimary" />

        <!-- Button 2: Chụp ảnh rác (Standard FAB Size, Brand Green, Icon Camera) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCapturePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Chụp ảnh rác mới"
            app:backgroundTint="?attr/colorPrimary"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_camera"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
